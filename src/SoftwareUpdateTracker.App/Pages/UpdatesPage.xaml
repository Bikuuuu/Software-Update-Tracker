<pages:FlyoutPage
    x:Class="SoftwareUpdateTracker.App.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:SoftwareUpdateTracker.App"
    xmlns:controls="using:SoftwareUpdateTracker.App.Controls"
    xmlns:pages="using:SoftwareUpdateTracker.App.Pages"
    xmlns:p="using:SoftwareUpdateTracker.Presentation"
    xmlns:updates="using:SoftwareUpdateTracker.Presentation.Updates"
    NavigationCacheMode="Required">
    <pages:FlyoutPage.Resources>
        <!-- One app in the Updates group: icon, name, versions, status line and actions. -->
        <DataTemplate x:Key="UpdateCard" x:DataType="updates:UpdateRow">
            <Border Style="{StaticResource Card}" Padding="12,10">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AppIcon Width="32" Height="32" VerticalAlignment="Top" LocalId="{x:Bind LocalId, Mode=OneWay}" AppName="{x:Bind Name, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind IsRemoved, Mode=OneWay}">
                        <TextBlock Text="{x:Bind p:Strings.Removed}" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                        <HyperlinkButton Content="{x:Bind p:Strings.Undo}" Command="{x:Bind UndoCommand}" Padding="4,2" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" Visibility="{x:Bind app:Ui.Collapsed(IsRemoved), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                            <Border Visibility="{x:Bind Auto, Mode=OneWay}" Padding="6,0,6,1" CornerRadius="8" VerticalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="{x:Bind p:Strings.Auto}" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Visibility="{x:Bind View.ShowVersions, Mode=OneWay}">
                            <Run Text="{x:Bind View.From, Mode=OneWay}" /><Run Text=" → " /><Run Text="{x:Bind View.To.Unchanged, Mode=OneWay}" /><Run Text="{x:Bind View.To.Changed, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </TextBlock>
                        <ProgressBar Margin="0,4" Visibility="{x:Bind View.ShowProgress, Mode=OneWay}" IsIndeterminate="{x:Bind View.Indeterminate, Mode=OneWay}" Value="{x:Bind View.Percent, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind View.Warning, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind View.Status, Mode=OneWay}" Style="{StaticResource Secondary}" TextWrapping="Wrap" MaxWidth="200" />
                            <TextBlock Text="·" Style="{StaticResource Secondary}" Visibility="{x:Bind View.ShowNotes, Mode=OneWay}" />
                            <HyperlinkButton Padding="0" MinHeight="0" FontSize="12" Content="{x:Bind p:Strings.WhatsNew}" Command="{x:Bind OpenNotesCommand}" Visibility="{x:Bind View.ShowNotes, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind app:Ui.Collapsed(IsRemoved), Mode=OneWay}">
                        <TextBlock Text="{x:Bind View.PercentText, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Button Content="{x:Bind View.ActionText, Mode=OneWay}" Command="{x:Bind PrimaryCommand}" Visibility="{x:Bind View.HasAction, Mode=OneWay}" />
                        <Button Content="{x:Bind p:Strings.Details}" Visibility="{x:Bind View.HasDetails, Mode=OneWay}">
                            <Button.Flyout>
                                <Flyout>
                                    <TextBlock Text="{x:Bind View.Details, Mode=OneWay}" IsTextSelectionEnabled="True" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{x:Bind CancelCommand}" Visibility="{x:Bind View.CanCancel, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind p:Strings.Cancel}" AutomationProperties.Name="{x:Bind p:Strings.Cancel}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Visibility="{x:Bind app:Ui.Collapsed(View.IsActive), Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind p:Strings.MoreOptions}" AutomationProperties.Name="{x:Bind p:Strings.MoreOptions}">
                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="{x:Bind p:Strings.UpdateNow}" Command="{x:Bind UpdateNowCommand}" Visibility="{x:Bind View.CanUpdateNow, Mode=OneWay}" />
                                    <MenuFlyoutItem Text="{x:Bind p:Strings.SkipVersion}" Command="{x:Bind SkipCommand}" Visibility="{x:Bind View.CanSkip, Mode=OneWay}" />
                                    <MenuFlyoutItem Text="{x:Bind p:Strings.UndoSkip}" Command="{x:Bind UndoSkipCommand}" Visibility="{x:Bind View.CanUndoSkip, Mode=OneWay}" />
                                    <ToggleMenuFlyoutItem Text="{x:Bind p:Strings.AutoUpdate}" IsChecked="{x:Bind Auto, Mode=OneWay}" Command="{x:Bind ToggleAutoCommand}" />
                                    <MenuFlyoutItem Text="{x:Bind p:Strings.WhatsNew}" Command="{x:Bind OpenNotesCommand}" Visibility="{x:Bind View.HasNotes, Mode=OneWay}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="{x:Bind p:Strings.StopTracking}" Command="{x:Bind StopTrackingCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One app in the Up to date group. -->
        <DataTemplate x:Key="UpToDateRow" x:DataType="updates:UpdateRow">
            <Grid Padding="12,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:AppIcon Width="24" Height="24" LocalId="{x:Bind LocalId, Mode=OneWay}" AppName="{x:Bind Name, Mode=OneWay}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{x:Bind app:Ui.Collapsed(IsRemoved), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind View.Status, Mode=OneWay}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Visibility="{x:Bind IsRemoved, Mode=OneWay}">
                    <TextBlock Text="{x:Bind p:Strings.Removed}" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
                    <HyperlinkButton Content="{x:Bind p:Strings.Undo}" Command="{x:Bind UndoCommand}" Padding="4,2" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Visibility="{x:Bind app:Ui.Collapsed(IsRemoved), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind p:Strings.MoreOptions}" AutomationProperties.Name="{x:Bind p:Strings.MoreOptions}">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind p:Strings.UpdateNow}" Command="{x:Bind UpdateNowCommand}" Visibility="{x:Bind View.CanUpdateNow, Mode=OneWay}" />
                            <MenuFlyoutItem Text="{x:Bind p:Strings.UndoSkip}" Command="{x:Bind UndoSkipCommand}" Visibility="{x:Bind View.CanUndoSkip, Mode=OneWay}" />
                            <ToggleMenuFlyoutItem Text="{x:Bind p:Strings.AutoUpdate}" IsChecked="{x:Bind Auto, Mode=OneWay}" Command="{x:Bind ToggleAutoCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="{x:Bind p:Strings.StopTracking}" Command="{x:Bind StopTrackingCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PreviewIcon" x:DataType="updates:UpdateRow">
            <controls:AppIcon Width="20" Height="20" Margin="0,0,2,0" LocalId="{x:Bind LocalId}" AppName="{x:Bind Name}" />
        </DataTemplate>

        <DataTemplate x:Key="NoticeBar" x:DataType="p:Notice">
            <InfoBar IsOpen="True" Title="{x:Bind Title}" Message="{x:Bind Message}" Severity="{x:Bind app:Ui.Severity(Severity)}" IsClosable="{x:Bind Closable}" Closed="OnNoticeClosed" />
        </DataTemplate>
    </pages:FlyoutPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Top" Padding="16,14,16,8" Spacing="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="Logo" Width="22" Height="22" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Software Update Tracker" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Updates.Summary, Mode=OneWay}" Style="{StaticResource Secondary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Command="{x:Bind Updates.CheckNowCommand}"
                            ToolTipService.ToolTip="{x:Bind p:Strings.CheckNow}" AutomationProperties.Name="{x:Bind p:Strings.CheckNow}">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="Spin" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="OnSettings"
                            ToolTipService.ToolTip="{x:Bind p:Strings.Settings}" AutomationProperties.Name="{x:Bind p:Strings.Settings}">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
            <InfoBar IsOpen="{x:Bind app:Ui.Has(Updates.Problem), Mode=OneWay}" IsClosable="False"
                     Title="{x:Bind Updates.Problem.Title, Mode=OneWay}" Message="{x:Bind Updates.Problem.Message, Mode=OneWay}" Severity="{x:Bind app:Ui.Severity(Updates.Problem.Severity), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="{x:Bind p:Strings.OpenStore}" Command="{x:Bind Updates.OpenStoreCommand}" Visibility="{x:Bind Updates.Problem.OffersStore, Mode=OneWay, FallbackValue=Collapsed}" />
                </InfoBar.ActionButton>
                <Button Content="{x:Bind p:Strings.Details}" Visibility="{x:Bind Updates.Problem.HasDetails, Mode=OneWay, FallbackValue=Collapsed}" Margin="0,0,0,8" Padding="0"
                        Background="Transparent" BorderThickness="0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                    <Button.Flyout>
                        <Flyout>
                            <TextBlock Text="{x:Bind Updates.Problem.Details, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap" MaxWidth="320" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </InfoBar>
            <ItemsControl ItemsSource="{x:Bind Updates.Notices}" ItemTemplate="{StaticResource NoticeBar}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="Body" Padding="16,0,16,12" Spacing="6">
                <StackPanel Visibility="{x:Bind Updates.IsEmpty, Mode=OneWay}" Spacing="12" Padding="0,12,0,16" HorizontalAlignment="Center">
                    <Image x:Name="EmptyLogo" Width="64" Height="64" />
                    <TextBlock Text="{x:Bind p:Strings.EmptyTitle}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" />
                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Content="{x:Bind p:Strings.ChooseApps}" Click="OnChooseApps" />
                </StackPanel>

                <TextBlock Text="{x:Bind p:Strings.UpdatesSection}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" Visibility="{x:Bind Updates.HasUpdates, Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind Updates.Updates}" ItemTemplate="{StaticResource UpdateCard}" XYFocusKeyboardNavigation="Enabled" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                </ItemsControl>

                <TextBlock Text="{x:Bind p:Strings.UpToDateSection}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" Visibility="{x:Bind Updates.HasUpToDate, Mode=OneWay}" />
                <Border Style="{StaticResource Card}" Visibility="{x:Bind Updates.HasUpToDate, Mode=OneWay}">
                    <StackPanel>
                        <Button Command="{x:Bind Updates.ToggleUpToDateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" Padding="12,8" AutomationProperties.Name="{x:Bind Updates.UpToDateText, Mode=OneWay}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{x:Bind Updates.UpToDatePreview, Mode=OneWay}" ItemTemplate="{StaticResource PreviewIcon}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Grid.Column="1" Text="{x:Bind Updates.UpToDateText, Mode=OneWay}" VerticalAlignment="Center" />
                                <FontIcon Grid.Column="2" Glyph="{x:Bind app:Ui.Chevron(Updates.IsUpToDateExpanded), Mode=OneWay}" FontSize="12" />
                            </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{x:Bind Updates.UpToDate}" ItemTemplate="{StaticResource UpToDateRow}" XYFocusKeyboardNavigation="Enabled" IsTabStop="False"
                                      Visibility="{x:Bind Updates.IsUpToDateExpanded, Mode=OneWay}">
                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ItemsControl.ItemContainerTransitions>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="Bottom" Grid.Row="2" Style="{StaticResource Footer}" Visibility="{x:Bind app:Ui.Collapsed(Updates.IsEmpty), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind Updates.NextCheck, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource Secondary}" />
            <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Content="{x:Bind Updates.UpdateAllText, Mode=OneWay}" Command="{x:Bind Updates.UpdateAllCommand}" />
        </Grid>
    </Grid>
</pages:FlyoutPage>
